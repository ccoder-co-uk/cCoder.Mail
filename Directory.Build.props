      Include="cCoder.CodeAnalysis"
      Version="2026.9.27.1258"
      PrivateAssets="all">
      <IncludeAssets>build;analyzers;buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
